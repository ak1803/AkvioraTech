{
  "entities": {
    "Suggestion": {
      "title": "Suggestion",
      "description": "A workflow or AI feature suggestion submitted by an authenticated user and evaluated by Akviora AI.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "description": "UID of the authenticated user who created the suggestion.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Display name and role of the author.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Category of the suggestion.",
          "enum": [
            "AI Workflow",
            "SaaS Feature",
            "UI/UX Experience",
            "Business Automation"
          ],
          "minLength": 1,
          "maxLength": 60
        },
        "suggestionText": {
          "type": "string",
          "description": "The workflow or feature suggestion content.",
          "minLength": 3,
          "maxLength": 1000
        },
        "businessGoal": {
          "type": "string",
          "description": "The target business goal or outcome.",
          "minLength": 1,
          "maxLength": 500
        },
        "aiAssessment": {
          "type": "string",
          "description": "Akviora AI architectural evaluation of the suggestion.",
          "minLength": 1,
          "maxLength": 1500
        },
        "recommendedPillar": {
          "type": "string",
          "description": "Recommended Akviora service pillar.",
          "minLength": 1,
          "maxLength": 200
        },
        "upvotes": {
          "type": "integer",
          "description": "Total upvote count for the suggestion."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the suggestion was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the suggestion was last updated."
        }
      },
      "required": [
        "authorId",
        "authorName",
        "category",
        "suggestionText",
        "businessGoal",
        "aiAssessment",
        "recommendedPillar",
        "upvotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Blueprint": {
      "title": "Blueprint",
      "description": "A 4-step AI and business automation blueprint generated by Akviora AI for a user.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "description": "UID of the authenticated user who generated the blueprint.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessType": {
          "type": "string",
          "description": "The user's business or industry type.",
          "minLength": 2,
          "maxLength": 200
        },
        "bottleneck": {
          "type": "string",
          "description": "The operational bottleneck described by the user.",
          "minLength": 3,
          "maxLength": 1000
        },
        "diagnosis": {
          "type": "string",
          "description": "Akviora AI diagnosis of the workflow bottleneck.",
          "minLength": 1,
          "maxLength": 1500
        },
        "recommendedAssistant": {
          "type": "string",
          "description": "Recommended Akviora AI Assistant and service pillar.",
          "minLength": 1,
          "maxLength": 200
        },
        "estimatedEfficiencyGain": {
          "type": "string",
          "description": "Quantified efficiency gain estimate.",
          "minLength": 1,
          "maxLength": 200
        },
        "stepsSummary": {
          "type": "string",
          "description": "Formatted 4-step implementation plan summary.",
          "minLength": 1,
          "maxLength": 3000
        },
        "stackSummary": {
          "type": "string",
          "description": "Recommended technology stack list.",
          "minLength": 1,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the blueprint was created."
        }
      },
      "required": [
        "authorId",
        "businessType",
        "bottleneck",
        "diagnosis",
        "recommendedAssistant",
        "estimatedEfficiencyGain",
        "stepsSummary",
        "stackSummary",
        "createdAt"
      ]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A private client project inquiry containing contact PII (email), accessible only to the inquiry owner or an admin.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "description": "UID of the authenticated user submitting the project inquiry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Client full name.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Client work email address (PII).",
          "minLength": 3,
          "maxLength": 160
        },
        "company": {
          "type": "string",
          "description": "Client company or startup name.",
          "minLength": 1,
          "maxLength": 160
        },
        "serviceInterest": {
          "type": "string",
          "description": "Selected Akviora service pillar.",
          "minLength": 1,
          "maxLength": 160
        },
        "budgetRange": {
          "type": "string",
          "description": "Estimated budget tier.",
          "minLength": 1,
          "maxLength": 100
        },
        "timeline": {
          "type": "string",
          "description": "Target project timeline.",
          "minLength": 1,
          "maxLength": 100
        },
        "problemStatement": {
          "type": "string",
          "description": "Description of the business problem or product idea.",
          "minLength": 3,
          "maxLength": 2000
        },
        "aiSummary": {
          "type": "string",
          "description": "AI-generated executive discovery call summary.",
          "minLength": 1,
          "maxLength": 1500
        },
        "status": {
          "type": "string",
          "description": "Current inquiry status.",
          "enum": ["New", "Reviewed", "Discovery Scheduled", "Completed"],
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the inquiry was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the inquiry was last updated."
        }
      },
      "required": [
        "authorId",
        "name",
        "email",
        "company",
        "serviceInterest",
        "budgetRange",
        "timeline",
        "problemStatement",
        "aiSummary",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin role marker document.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin verified email.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/suggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/Suggestion" },
      "description": "Stores user workflow and AI suggestions with Akviora AI architectural evaluations."
    },
    "/blueprints/{blueprintId}": {
      "schema": { "$ref": "#/entities/Blueprint" },
      "description": "Stores user-generated 4-step AI workflow blueprints."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Stores private client project inquiries with strict owner/admin PII isolation."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Stores trusted administrator UIDs."
    }
  }
}
